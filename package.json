    "verify:v2-5-10-stage1": "node scripts/verify-v2-5-10-stage1.cjs",
    "v2-5-9:uat": "node scripts/windows-uat/v2-5-9-ae-runtime.cjs",
    "v2-5-9:ae": "node scripts/windows-uat/v2-5-9-ae-runtime.cjs",
    "v2-5-10:stage1": "node scripts/verify-v2-5-10-stage1.cjs",
    "v2-5-10:validate-ae": "node scripts/windows-uat/validate-ae-evidence-pack.cjs",
    "v2-5-10:stage2-inventory": "node tests/baseline/test-v2-5-10-stage2-inventory.js",
    "v2-5-10:ops-keys": "node scripts/inventory-operational-keys.cjs",
    "v2-5-10:registry-drift": "node scripts/check-feature-registry-drift.cjs",
    "v2-5-10:category-b": "node tests/baseline/test-v2-5-10-category-b.js",
    "v2-5-7:scenarios": "node scripts/v2-5-7-scenarios-all.cjs",
    "v2-5-stabilization:scenarios": "node scripts/v2-5-stabilization-scenarios-all.cjs",
    "v2-5-stabilization:uat": "node scripts/windows-uat/v2-5-stabilization-runtime.cjs",
    "v2-5-8:scenarios": "node scripts/v2-5-8-scenarios-all.cjs",
    "v2-5-8:uat": "node scripts/windows-uat/v2-5-8-activation-runtime.cjs",
    "v2-5-7:artifacts": "node scripts/v2-5-7-release-artifacts.cjs",
    "v2-5-7:migration": "node scripts/v2-5-7-migration-harness.cjs",
    "v2-5-7:lifecycle": "node scripts/v2-5-7-lifecycle-matrix.cjs",
    "v2-5-7:uat": "node scripts/windows-uat/v2-5-7-release-runtime.cjs"
