    "verify:client-import": "node scripts/verify-client-import.js",
    "verify:ledger": "node scripts/verify-ledger-monthly.js",
    "verify:tax-invoice": "node scripts/verify-tax-invoice.js",
    "verify:import": "node scripts/verify-client-import.js",
    "verify:sensitive": "node scripts/verify-attendance-policy.js && node scripts/verify-ledger-monthly.js && node scripts/verify-tax-invoice.js && node scripts/verify-backup-sync.js && node scripts/verify-client-import.js && npm run license:test",
