  "build": {
    "appId": "com.tadawi.cuppingcenter",
    "productName": "Hijama Management System",
    "copyright": "Copyright © 2026 NajjarTech. All rights reserved.",
    "icon": "build/Program-Icon.ico",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "branding.config.json",
      "import-engine-core.js",
      "import-engine-worker.js",
      "migration/**/*",
      "database/**/*",
      "renderer/**/*",
      "cloud/**/*",
      "cupping-*.js",
      "import-studio/**/*",
      "license/**/*",
      "assets/**/*",
      "branding/**/*",
      "templates/**/*",
      "electron/**/*",
      "electron/cloud-oauth.config.json",
      "package.json",
      "node_modules/**/*",
      "!tools/**/*",
      "!tests/**/*",
      "!docs/**/*",
      "!**/*.map",
      "!**/node_modules/**/{CHANGELOG.md,README.md,readme.md,test,tests,__tests__,docs,example,examples}",
      "!**/node_modules/.bin/**"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**",
      "node_modules/google-auth-library/**",
      "node_modules/gaxios/**",
      "node_modules/gcp-metadata/**",
      "node_modules/gtoken/**",
      "node_modules/jws/**",
      "node_modules/jwa/**"
    ],
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "compression": "normal",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/Program-Icon.ico",
      "artifactName": "HijamaManagement-Setup-${version}.${ext}",
      "legalTrademarks": "NajjarTech",
      "signtoolOptions": {
        "publisherName": "NajjarTech"
      },
      "signAndEditExecutable": false,
      "requestedExecutionLevel": "asInvoker",
      "executableName": "Hijama Management System"
    },
    "afterPack": "./scripts/electron-builder-after-pack.cjs",
    "nsis": {
      "oneClick": false,
      "differentialPackage": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "installerIcon": "build/Program-Icon.ico",
      "uninstallerIcon": "build/Program-Icon.ico",
      "installerHeaderIcon": "build/Program-Icon.ico",
      "installerSidebar": "build/Installer-Sidebar.bmp",
      "installerHeader": "build/Installer-Header.bmp",
      "uninstallerSidebar": "build/Uninstaller-Sidebar.bmp",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Hijama Management System",
      "uninstallDisplayName": "Hijama Management System",
      "menuCategory": "NajjarTech",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "unicode": true,
      "warningsAsErrors": false,
      "installerLanguages": [
        "en_US"
      ],
      "displayLanguageSelector": false,
      "removeDefaultUninstallWelcomePage": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "electron": "^43.2.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.31.0",
    "jimp": "^1.6.1",
    "playwright": "^1.61.1",
    "resedit": "^2.0.3",
    "sharp": "^0.35.2",
    "to-ico": "^1.1.5"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.2",
    "fflate": "^0.8.3",
    "google-auth-library": "^9.15.1",
    "qrcode-generator": "^2.0.4",
    "xlsx": "^0.18.5"
  }
}
