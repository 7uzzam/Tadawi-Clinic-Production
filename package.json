    "build:test": "node tests/baseline/test-phase12-build.js",
    "electron:test": "node tests/baseline/test-phase13-electron-readiness.js",
    "finalgate:test": "node tests/baseline/test-phase14-final-gate.js",
    "rcgate:test": "node tests/baseline/test-phase15-rc-gate.js",
