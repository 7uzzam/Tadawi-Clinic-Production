    "cloud:test": "node scripts/verify-cloud-v2.js",
    "multibranch:test": "node tests/baseline/test-phase18-multibranch-cloud.js",
    "ownerhub:test": "node tests/baseline/test-phase19-owner-hub.js",
    "releasegate:test": "node tests/baseline/test-phase20-production-release.js",
    "pat": "node scripts/pat-acceptance-test.mjs",
    "fpa": "node scripts/fpa-final-audit.mjs",
    "fpv": "node scripts/fpv-final-production-validation.mjs",
    "rc": "node scripts/rc-validation.mjs",
    "freeze:gate": "node scripts/code-freeze-gate.mjs",
    "release:evidence": "node scripts/release-evidence-bundle.mjs",
    "release:gate": "node scripts/production-release-gate.mjs",
    "sqlite:sot:dry-run": "node scripts/sqlite-sot-dry-run.mjs",
    "hybrid:icon:test": "node tests/baseline/test-hybrid-icon-packaging.js",
    "hybrid:backup:test": "node tests/baseline/test-hybrid-backup-v2.js",
    "verify:release-gate": "node scripts/verify-v2-3-5-completion.cjs",
    "verify:v2-4-release-gate": "node scripts/verify-v2-4-completion.cjs",
    "verify:v2-5-1-release-gate": "node scripts/verify-v2-5-1-completion.cjs",
    "verify:v2-5-2-release-gate": "node scripts/verify-v2-5-2-completion.cjs",
    "v2-5-1:scenarios": "node scripts/v2-5-1-scenarios-all.cjs",
    "v2-5-2:scenarios": "node scripts/v2-5-2-scenarios-all.cjs",
    "verify:uninstall-prep": "node scripts/verify-uninstall-prep.js",
    "uat:owner-rbac": "node scripts/windows-uat/owner-rbac-runtime.cjs",
    "inspect:win-icon": "node scripts/inspect-win-exe-icon.cjs",
    "v2-4:scenarios": "node scripts/v2-4-scenarios-all.cjs",
    "v2-4:fill-trace": "node scripts/v2-4-fill-traceability.cjs",
    "v2-4:real-drive-uat": "node scripts/v2-4-real-drive-uat.cjs",
    "verify:v2-5-3-release-gate": "node scripts/verify-v2-5-3-completion.cjs",
    "v2-5-3:scenarios": "node scripts/v2-5-3-scenarios-all.cjs",
    "verify:v2-5-4-release-gate": "node scripts/verify-v2-5-4-completion.cjs",
    "v2-5-4:scenarios": "node scripts/v2-5-4-scenarios-all.cjs",
    "verify:v2-5-5-release-gate": "node scripts/verify-v2-5-5-completion.cjs",
    "v2-5-5:scenarios": "node scripts/v2-5-5-scenarios-all.cjs",
    "v2-5-5:perf": "node scripts/v2-5-5-perf-bench.cjs",
    "v2-5-5:scale": "node scripts/v2-5-5-scale-dataset.cjs",
    "verify:v2-5-6-release-gate": "node scripts/verify-v2-5-6-completion.cjs",
    "v2-5-6:scenarios": "node scripts/v2-5-6-scenarios-all.cjs",
